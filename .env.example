# -----------------------------------------------------------------------------
# Eco-Hive - Environment Variables Template
# Copy this file to '.env.local' and fill in your actual credentials.
# NEVER commit '.env' or '.env.local' to version control!
# -----------------------------------------------------------------------------

# Public Variables (Accessible in browser)
NEXT_PUBLIC_CURRENCY=MMK
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Authentication (Clerk)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ecohive?retryWrites=true&w=majority

# Background Tasks & Event Processing (Inngest)
INNGEST_SIGNING_KEY=signkey-prod-your_inngest_signing_key_here
INNGEST_EVENT_KEY=your_inngest_event_key_here

# Cloud Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
