# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# turbo
.turbo/

# lock files
yarn.lock
pnpm-lock.yaml

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE and OS
.vscode/
.idea/
Thumbs.db
.DS_Store
*.pem

# backup files
*.bak
*.tmp

# ignore send map
/send map/send map/node_modules/
/send map/send map/.next/
/send map/send map/build/

# Environment variables (NEVER commit secrets!)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
